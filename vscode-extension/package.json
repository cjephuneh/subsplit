{
  "name": "subsplit-ai",
  "displayName": "Subsplit AI Assistant",
  "description": "Drop-in AI Coding Assistant powered by your Subsplit wallet.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "subsplit.chat",
        "title": "Subsplit: Open AI Chat"
      },
      {
        "command": "subsplit.login",
        "title": "Subsplit: Connect Wallet"
      },
      {
        "command": "subsplit.logout",
        "title": "Subsplit: Disconnect Wallet"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.0.0"
  }
}
